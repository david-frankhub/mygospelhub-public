{
  "name": "mygospelhub",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/song", "/song.html", "/song/*", "/video", "/video.html", "/video/*", "/gist-post", "/gist-post.html", "/gist/*", "/sitemap.xml"]
  }
}
